# Copy file nay thanh .env roi dien gia tri.
# backend/.env duoc nap TU DONG khi khoi dong (xem core/config.py -> model_config["env_file"]).
# Tien to bien: DETECT_AI_

# ===== Supabase =====
# De TRONG ca 4 dong => backend chay SQLite (backend/data/detect_ai.db) + luu file tren dia.
# Dien DU 4 dong  => chay hoan toan tren Supabase (PostgreSQL + Storage).
# Huong dan chi tiet: docs/DATABASE_SETUP_GUIDE.md
DETECT_AI_SUPABASE_URL=
DETECT_AI_SUPABASE_KEY=
DETECT_AI_SUPABASE_SERVICE_KEY=
DETECT_AI_SUPABASE_DB_URL=

# ===== Bao mat (BAT BUOC doi truoc khi trien khai that) =====
# Bo comment roi dien gia tri. Neu de comment, he thong dung gia tri demo cong khai
# trong core/config.py -> bat ky ai doc ma nguon deu ky duoc JWT.
# DETECT_AI_JWT_SECRET=

# ===== AI Engine (tuy chon, giu lai YOLO dong phuc cho tuong lai) =====
DETECT_AI_YOLO_CONF=0.35
DETECT_AI_YOLO_IMGSZ=384
# ONNX: export 1 lan bang `uv run detect-ai-export-onnx`.
# Thu tu uu tien weights: explicit > custom uniform (.pt) > yolo26n.onnx > yolo26n.pt fallback.
# DETECT_AI_YOLO_ONNX=data/weights/yolo26n.onnx
# auto = tu chon theo phan cung (cuda/tensorrt/dml/coreml/openvino/cpu); cpu = ep chay CPU.
# DETECT_AI_YOLO_PROVIDER=auto
# 0 = auto (min(4, cpu//2)); dat so duong de ep so thread CPU cho YOLO/ONNX.
# DETECT_AI_YOLO_THREADS=0

# ===== Recognition (face kiosk + uniform, engine duy nhất) =====
# Ngưỡng margin chống nhầm 2 bạn giống nhau (top1-top2 >= mới chốt).
# RECOGNITION_FACE_MARGIN_MIN=0.05
# Dải lưng chừng -> yêu cầu chớp mắt/quay đầu (challenge).
# RECOGNITION_CHALLENGE_LOW=0.55
# MiniFASNetV2 (lớp chống giả thứ 2, optional): đặt file vào backend/data/weights/minifas_v2.onnx
# hoặc điền path tuyệt đối vào dưới đây. CẢNH BÁO: bản ONNX công khai trên HF (09/2026)
# cho output hằng, phải tự export từ PyTorch gốc + verify phân biệt thật/giả trước khi dùng.
# RECOGNITION_MINIFAS_MODEL=
# Uniform run-once lúc check-in (không chạy mọi frame).
# RECOGNITION_UNIFORM_IMGSZ=384
# RECOGNITION_UNIFORM_PROVIDER=auto

# ===== Face Kiosk (InsightFace buffalo_s/l + Liveness passive) =====
# auto = buffalo_l khi co GPU, buffalo_s khi CPU-only; ép tay: buffalo_s | buffalo_l.
DETECT_AI_FACE_PACK=auto
# det_size SCRFD tren person-crop: 256 nhanh, 640 chính xác hơn.
# Code chay: det 256, vote 2/4s (env cu ghi 320/3/2s la sai).
DETECT_AI_FACE_DET_SIZE=256
# cosine >= threshold mới điểm danh; unsure_low..threshold = "chưa xác định".
DETECT_AI_FACE_THRESHOLD=0.45
DETECT_AI_FACE_UNSURE_LOW=0.35
# Voting: đúng cùng 1 SV N lần trong cửa sổ W giây mới chốt (chống nhảy tên).
DETECT_AI_FACE_VOTE_N=2
DETECT_AI_FACE_VOTE_WINDOW_S=4.0
DETECT_AI_FACE_MIN_SIZE=45
DETECT_AI_FACE_MAX_FACES=3
# Liveness passive (addons/liveness.onnx, ngưỡng chính chủ InsightFace 0.8).
# Model yêu cầu ảnh gốc + 5-point landmarks để tự căn mặt — không tự cắt bbox.
# Chống flicker người <-> giả mạo: 1 frame tốt hiện tên ngay (>= LIVE_THR),
# cần MIN_FRAMES frame xấu liên tiếp (< SPOOF_THR) mới chốt SPOOF.
DETECT_AI_SPOOF_THRESHOLD=0.8
DETECT_AI_SPOOF_LIVE_THR=0.8
DETECT_AI_SPOOF_MIN_FRAMES=2
DETECT_AI_SPOOF_QUALITY_MIN=0.35
# Rỗng = tự tìm ~/.insightface/addons/liveness.onnx; điền path .onnx để ép model khác.
# DETECT_AI_SPOOF_MODEL=
DETECT_AI_FACE_GALLERY_CACHE_TTL_S=300
